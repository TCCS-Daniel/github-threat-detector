GITHUB_TOKEN=ghp_your_personal_access_token_here
DATABASE_URL=postgresql://postgres@localhost:5432/threat_detector
GITHUB_REPOS=aquasecurity/trivy,kubernetes/kubernetes
GITHUB_ORGS=supplychain-labs
TARGET_REPO_PREFIX=sim

# Optional collectors run by the UI "Collect + Analyze" button (comma-separated).
# Any of: actions,contributors,workflow-files,commits,scan-parents,git-inspect,
#         tags,activities,snapshots,author-search
# Empty = basic event collection only (same as `python cli.py collect` with no flags).
RUN_COLLECTORS=

# Only needed if the UI is hosted on a different origin than the API.
# CORS_ALLOW_ORIGINS=https://ui.example.com
